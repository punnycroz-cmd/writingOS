## Forensic directory scaffold

```sh
mkdir -p forensic/phase2b-5/{git,historical,current,intermediate,scripts,test-results,reconciliation-history}
# Capture git state
{ git status; git branch -a; git remote -v | sed -E 's#(https://[^@]*@)#https://[REDACTED]@#g'; git log --oneline --decorate --graph -50; git log --stat -20; git reflog; git rev-parse --abbrev-ref HEAD; git rev-parse HEAD; git rev-parse --abbrev-ref --symbolic-full-name @{u}; } > forensic/phase2b-5/git-state.txt 2>&1
# Capture git diff + file lists
{ git status; git diff; git diff --cached; git ls-files | head -100; git ls-files --others --exclude-standard; git ls-files --others --ignored --exclude-standard | head -80; } > forensic/phase2b-5/git/git-snapshot.txt 2>&1
git ls-files > forensic/phase2b-5/git/tracked-files.txt
git ls-files --others --exclude-standard > forensic/phase2b-5/git/untracked-files.txt
git ls-files --others --ignored --exclude-standard > forensic/phase2b-5/git/ignored-files.txt
git log --format='%H|%s|%D|%P' -30 > forensic/phase2b-5/git/commit-map.txt
```

